              }
            ]
          },
          "docs": "Retrieve a summary"
        },
        {
          "info": {
            "name": "Delete a summary",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.whereby.dev/v1/summaries/:summaryId",
            "params": [
              {
                "name": "summaryId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a summary"
        }
      ]
    }
